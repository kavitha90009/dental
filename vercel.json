{
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 */2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/track/open",
      "destination": "/api/notify"
    },
    {
      "source": "/api/patient-notification-action",
      "destination": "/api/notify"
    },
    {
      "source": "/patient/link",
      "destination": "/patient/link.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/dashboard/index.html"
    }
  ]
}
